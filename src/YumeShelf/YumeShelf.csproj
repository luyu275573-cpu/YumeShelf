<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YumeShelf</RootNamespace>
    <AssemblyName>YumeShelf</AssemblyName>
    <ApplicationIcon>Assets\YumeShelf.ico</ApplicationIcon>
    <Version>0.3.0-preview.1</Version>
    <Product>YumeShelf</Product>
    <Description>YumeShelf · 一个更懂你的游戏盒子</Description>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Application\AI\Skills\*.md" />
    <Content Include="Assets\Backgrounds\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\DefaultCover.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\YumeShelfIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\YumeShelf.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

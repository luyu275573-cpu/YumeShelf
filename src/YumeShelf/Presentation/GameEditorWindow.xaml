<Window x:Class="YumeShelf.Presentation.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑游戏信息"
        Width="520"
        Height="640"
        MinWidth="460"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DetailBackground}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="编辑游戏信息" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />
        <TextBlock Grid.Row="1" Text="标题" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
        <TextBox x:Name="TitleBox" Grid.Row="2" Style="{StaticResource EditorTextBox}" />
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,7,0">
                <TextBlock Text="引擎" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="EngineBox" Style="{StaticResource EditorTextBox}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                <TextBlock Text="年份" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
                <TextBox x:Name="YearBox" Style="{StaticResource EditorTextBox}" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="4" Text="工作目录" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,5" />
        <TextBox x:Name="WorkingDirectoryBox" Grid.Row="5" Style="{StaticResource EditorTextBox}" />
        <StackPanel Grid.Row="6" Margin="0,14,0,0">
            <TextBlock Text="启动参数" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,5" />
            <TextBox x:Name="ArgumentsBox" Style="{StaticResource EditorTextBox}" />
            <TextBlock Text="封面路径（可选）" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,5" />
            <DockPanel>
                <TextBox x:Name="CoverBox" Style="{StaticResource EditorTextBox}" />
                <Button Content="选择" Click="ChooseCover_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
            </DockPanel>
            <TextBlock Text="简介" Foreground="{DynamicResource MutedTextBrush}" Margin="0,14,0,5" />
            <TextBox x:Name="DescriptionBox" MinHeight="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource EditorTextBox}" />
        </StackPanel>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" />
            <Button Content="保存" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>

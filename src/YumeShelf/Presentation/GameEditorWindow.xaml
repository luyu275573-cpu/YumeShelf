<Window x:Class="YumeShelf.Presentation.GameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑游戏信息" Width="560" Height="720" MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="编辑游戏信息" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="标题" Margin="0,0,0,5"/>
                <TextBox x:Name="TitleBox" MaxLength="200" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="游戏标题"/>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="引擎"/><TextBox x:Name="EngineBox" MaxLength="80" Style="{StaticResource EditorTextBox}" Margin="0,5,0,0" AutomationProperties.Name="游戏引擎"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="发行年份"/><TextBox x:Name="YearBox" MaxLength="4" Style="{StaticResource EditorTextBox}" Margin="0,5,0,0" AutomationProperties.Name="发行年份"/></StackPanel>
                </Grid>
                <TextBlock Text="启动文件" Margin="0,14,0,5"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutableBox" IsReadOnly="True" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="启动文件路径"/>
                    <Button x:Name="RelinkButton" Grid.Column="1" Content="重新选择" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="移动游戏后可重新选择启动文件，保留原有资料和游玩记录。运行中的游戏结束后才能更换入口。" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <TextBlock Text="工作目录" Margin="0,14,0,5"/>
                <TextBox x:Name="WorkingDirectoryBox" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="工作目录"/>
                <TextBlock Text="启动参数" Margin="0,14,0,5"/>
                <TextBox x:Name="ArgumentsBox" MaxLength="4096" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="启动参数"/>
                <TextBlock Text="游戏封面（可选）" Margin="0,14,0,5"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="CoverBox" Style="{StaticResource EditorTextBox}" LostFocus="CoverBox_LostFocus" AutomationProperties.Name="封面路径"/>
                    <Button Grid.Column="1" Content="选择" Click="ChooseCover_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                </Grid>
                <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Margin="0,10,0,0" Height="100"><Image x:Name="CoverPreview" Stretch="Uniform"/></Border>
                <TextBlock Text="简介" Margin="0,14,0,5"/>
                <TextBox x:Name="DescriptionBox" Height="140" MaxLength="20000" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="游戏简介"/>
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{DynamicResource FeedbackErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
            <Button Content="保存" IsDefault="True" Click="Save_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>

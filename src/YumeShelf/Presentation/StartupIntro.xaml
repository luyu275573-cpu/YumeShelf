<UserControl x:Class="YumeShelf.Presentation.StartupIntro"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackground}"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="YumeShelf 启动介绍">
    <Grid x:Name="IntroSurface" Background="{DynamicResource WindowBackground}">
        <StackPanel x:Name="BrandGroup" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0,24,46">
            <Image x:Name="IntroIcon" Width="96" Height="96" Stretch="Uniform" Margin="0,0,0,28" Opacity="0"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="YumeShelf YS 图标"/>
            <TextBlock x:Name="AppNameText" Text="YumeShelf" FontFamily="Segoe UI" FontSize="48" FontWeight="SemiBold" Opacity="0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock x:Name="TaglineText" Text="一个更懂你的游戏盒子..." FontSize="20" Margin="0,18,0,0" Opacity="0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
        <Button x:Name="EnterLibraryButton" Content="进入游戏库" Click="EnterLibrary_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28" Padding="16,9"
                Style="{StaticResource SecondaryButton}" ToolTip="跳过介绍（Enter / Esc）"
                AutomationProperties.Name="跳过启动介绍并进入游戏库"/>
    </Grid>
</UserControl>

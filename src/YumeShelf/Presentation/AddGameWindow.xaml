<Window x:Class="YumeShelf.Presentation.AddGameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YumeShelf.Presentation" Title="添加游戏" Width="760" Height="600" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryTextBrush}">
<Window.Resources>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Setter Property="Background" Value="{DynamicResource Surface2Brush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="128"/><Setter Property="Height" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Opacity" Value="0.88"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="添加游戏" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="把本地游戏整理到你的收藏库" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="步骤 1 / 1" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/></DockPanel>
  <TabControl Grid.Row="1" Height="170" x:Name="ModeTabs" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}" SelectionChanged="ModeTabs_SelectionChanged"><TabItem Header="自动搜索添加"><Border Height="128" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18"><StackPanel><TextBlock Text="搜索范围" FontWeight="SemiBold"/><TextBlock Text="选择一个磁盘或文件夹，YumeShelf 会识别其中可能的视觉小说游戏。" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,13"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RootBox" Text="{Binding SearchRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBox}"/><Button Grid.Column="1" Content="选择文件夹" Click="ChooseFolder_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/></Grid></StackPanel></Border></TabItem><TabItem Header="手动添加"><Border Height="128" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18"><StackPanel VerticalAlignment="Center"><TextBlock Text="手动选择启动文件" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,0" Text="适合添加扫描未识别到的游戏，支持 Windows .exe 文件。" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel></Border></TabItem></TabControl>
  <DockPanel Grid.Row="2" Margin="0,22,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="扫描结果" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="  ·  可多选" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,1" TextWrapping="NoWrap"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="全选" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6"/><Button Content="取消全选" Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="8,0,0,0"/></StackPanel></DockPanel>
  <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><ListBox ItemsSource="{Binding Candidates}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource Surface2Brush}" CornerRadius="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,3,12,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/><TextBlock FontSize="12" Margin="0,5,0,0"><Run Text="{Binding Engine}" Foreground="{DynamicResource AccentTextBrush}"/><Run Text="  ·  "/><Run Text="{Binding Reason}" Foreground="{DynamicResource MutedTextBrush}"/></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding Score, StringFormat=匹配度 {0}}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
  <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="76"/><Button x:Name="ActionButton" Content="开始扫描" Click="ActionButton_Click" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource PrimaryButton}" MinWidth="106" Margin="10,0,0,0"/></StackPanel>
  </Grid>
  <local:FeedbackToast DataContext="{Binding Feedback}" Grid.RowSpan="5" Panel.ZIndex="10"/>
 </Grid>
</Window>

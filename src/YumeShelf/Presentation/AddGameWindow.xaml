<Window x:Class="YumeShelf.Presentation.AddGameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:YumeShelf.Presentation" xmlns:application="clr-namespace:YumeShelf.Application" Title="添加游戏" Width="800" Height="680" MinWidth="680" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryTextBrush}">
<Window.Resources>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style x:Key="ModeTabFocusRing" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Rectangle Margin="2,2,10,2" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2" StrokeDashArray="2 1" RadiusX="6" RadiusY="6"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinWidth" Value="128"/>
    <Setter Property="Height" Value="42"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource ModeTabFocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <!-- TabPanel subtracts item margins when arranging headers; keep the gap inside the template to avoid clipping. -->
      <Border x:Name="TabChrome" Margin="0,0,8,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
          <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Opacity" Value="0.88"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="添加游戏" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="选择范围 · 核对结果 · 确认入库" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel>
  <TabControl Grid.Row="1" Height="206" x:Name="ModeTabs" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}" SelectionChanged="ModeTabs_SelectionChanged">
    <TabItem Header="自动搜索添加">
      <Border x:Name="AutoPanel" Height="160" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18">
        <StackPanel>
          <Grid>
            <TextBlock Text="搜索范围" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ComboBox x:Name="ScanModeBox" Width="190" Height="34" HorizontalAlignment="Right" Style="{StaticResource FilterComboBox}" AutomationProperties.Name="扫描模式" SelectedValuePath="Tag" SelectedValue="{Binding ScanMode, Mode=TwoWay}">
              <ComboBoxItem Content="视觉小说优先" Tag="{x:Static application:GameScanMode.VisualNovel}"/>
              <ComboBoxItem Content="扩展游戏扫描" Tag="{x:Static application:GameScanMode.Expanded}"/>
            </ComboBox>
          </Grid>
          <Grid Margin="0,10,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="RootBox" Text="{Binding SearchRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditorTextBox}" AutomationProperties.Name="搜索磁盘或文件夹" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="选择文件夹" Click="ChooseFolder_Click" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
          </Grid>
          <TextBlock Text="{Binding ScanModeDescription}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </TabItem>
    <TabItem Header="手动添加">
      <Border x:Name="ManualPanel" Height="160" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0,8,8,8" Padding="18">
        <StackPanel VerticalAlignment="Center"><TextBlock Text="手动选择启动文件" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,0" Text="适合添加扫描未识别到的游戏，支持 Windows .exe 文件。" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel>
      </Border>
    </TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="0,18,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="扫描结果 · 可多选" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}">
      <Button x:Name="RescanButton" Content="重新扫描" Click="RescanButton_Click" Padding="10,6" Margin="0,0,8,0">
        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=ModeTabs}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="全选" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6"/>
      <Button Content="取消全选" Command="{Binding ClearAllCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
  <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
    <Grid>
      <ListBox x:Name="ResultsList" ItemsSource="{Binding Candidates}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="12" Margin="0,0,0,6" Background="{DynamicResource Surface2Brush}" CornerRadius="7">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title, StringFormat=选择游戏 {0}}" VerticalAlignment="Top" Margin="0,3,12,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                  <TextBlock Text="{Binding ExecutablePath}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" Margin="0,3,0,0"/>
                  <TextBlock Text="{Binding Engine}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                  <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding ReviewLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Top" Margin="10,0,0,0"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="候选游戏将在这里显示。可切换扫描模式，或手动选择启动文件。" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="18" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Candidates.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </Grid>
  </Border>
  <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="76"/><Button x:Name="ActionButton" Content="开始扫描" Click="ActionButton_Click" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource PrimaryButton}" MinWidth="106" Margin="10,0,0,0"/></StackPanel>
  </Grid>
  <local:FeedbackToast DataContext="{Binding Feedback}" Grid.RowSpan="5" Panel.ZIndex="10"/>
 </Grid>
</Window>

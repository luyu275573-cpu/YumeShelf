<UserControl x:Class="YumeShelf.Presentation.AiAssistantPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,28,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Yume · Galgame 助手" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="专注 Galgame、视觉小说与 YumeShelf 使用" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ConversationScrolled">
                <ItemsControl ItemsSource="{Binding Conversation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,0" AutomationProperties.Name="对话消息"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBox Grid.Row="2" x:Name="QueryEditor" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsBusy}" Style="{StaticResource EditorTextBox}" AcceptsReturn="True"
                 TextWrapping="Wrap" MinHeight="82" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                 Margin="0,16,0,12" AutomationProperties.Name="向 Yume 提问" ToolTip="输入 Galgame 问题，点击发送"/>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="停止" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="发送" Command="{Binding SendCommand}" Style="{StaticResource PrimaryButton}" MinWidth="76"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

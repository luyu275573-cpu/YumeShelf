<UserControl x:Class="YumeShelf.Presentation.FeedbackToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
             HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="460">
    <Border x:Name="Chrome" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="16" DataContext="{Binding Current}">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Top">
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource FeedbackSuccessBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource FeedbackErrorBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource FeedbackWarningBrush}"/></DataTrigger>
                    </Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="NoticeText" Text="{Binding Message}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
                <Button Content="{Binding ActionLabel}" Command="{Binding Action}" Style="{StaticResource SecondaryButton}"
                        Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="×" Width="28" Height="28" VerticalAlignment="Top" Padding="0"
                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Style="{StaticResource SecondaryButton}" ToolTip="关闭提示" AutomationProperties.Name="关闭操作提示"/>
        </Grid>
    </Border>
</UserControl>
